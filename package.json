{
  "name": "qompta",
  "version": "1.20.2",
  "description": "Comptabilité & TVA suisse multi-sociétés (Electron)",
  "author": "Qompta",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "predev": "npm run rebuild:electron",
    "dev": "electron-vite dev",
    "dev:restart": "node scripts/restart-app.mjs",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && npm run rebuild:electron && electron-builder --win --config electron-builder.yml",
    "postbuild:win": "node scripts/release-housekeeping.mjs",
    "stage:installer": "node scripts/stage-installer.mjs",
    "build:mac": "npm run build && npm run rebuild:electron && electron-builder --mac --config electron-builder.yml",
    "pack:linux": "npm run build && npm run rebuild:electron && electron-builder --linux --config electron-builder.yml",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pretest": "npm run rebuild:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "preseed": "npm run rebuild:node",
    "seed": "tsx src/db/seed.ts",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -o better-sqlite3",
    "lint": "echo \"(lint placeholder)\""
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.38.4",
    "swissqrbill": "^4.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.30.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "lucide-react": "^0.471.1",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "xlsx": "^0.18.5"
  }
}
